{
  "entities": {
    "Work": {
      "title": "Work",
      "description": "An original creative work or series that characters, videos, and songs belong to.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Title of the work."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Short summary of the work."
        },
        "externalUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional external link for the work."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["title", "description", "externalUrl", "order", "ownerId", "createdAt", "updatedAt"]
    },
    "Character": {
      "title": "Character",
      "description": "A character profile belonging to a work.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Character display name."
        },
        "workId": {
          "type": "string",
          "maxLength": 128,
          "description": "Referenced work document ID, or empty string if unassigned."
        },
        "coverImage": {
          "type": "object",
          "description": "Portrait (832x1216) cover image object {url, source, storagePath?, width?, height?}."
        },
        "heroImage": {
          "type": "object",
          "description": "Portrait (832x1216) detail image object {url, source, storagePath?, width?, height?}."
        },
        "tagline": {
          "type": "string",
          "maxLength": 300,
          "description": "One-line character introduction."
        },
        "introduction": {
          "type": "string",
          "maxLength": 10000,
          "description": "Detailed character introduction prose."
        },
        "crackUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "External Crack chat URL."
        },
        "caveduckUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "External Caveduck chat URL."
        },
        "relatedUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "External related character URL."
        },
        "infoItems": {
          "type": "array",
          "description": "Admin-editable key-value metadata rows (max 30 items)."
        },
        "gallery": {
          "type": "array",
          "description": "List of landscape (1216x832) or portrait (832x1216) gallery image objects {url, source, storagePath?, width?, height?} (max 30 items)."
        },
        "relatedWorkLinks": {
          "type": "array",
          "description": "List of related work link objects (max 20 items)."
        },
        "prompts": {
          "type": "array",
          "description": "Appearance prompt blocks {label, version, text} (max 30 items)."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "name",
        "workId",
        "coverImage",
        "heroImage",
        "tagline",
        "introduction",
        "crackUrl",
        "caveduckUrl",
        "relatedUrl",
        "infoItems",
        "gallery",
        "relatedWorkLinks",
        "prompts",
        "order",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Video": {
      "title": "Video",
      "description": "A YouTube video archive item.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Video display title."
        },
        "youtubeUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Original YouTube URL."
        },
        "youtubeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parsed YouTube video ID."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional video note."
        },
        "characterIds": {
          "type": "array",
          "description": "Connected character document IDs (max 30 items)."
        },
        "workId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional referenced work ID."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["title", "youtubeUrl", "youtubeId", "description", "characterIds", "workId", "order", "ownerId", "createdAt", "updatedAt"]
    },
    "Song": {
      "title": "Song",
      "description": "A CD album music track with audio, lyrics, and linked characters.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Song or album title."
        },
        "artist": {
          "type": "string",
          "maxLength": 120,
          "description": "Creator or vocalist credit."
        },
        "coverImage": {
          "type": "object",
          "description": "Album sleeve artwork object {url, source}."
        },
        "audioUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "MP3 audio file URL."
        },
        "lyrics": {
          "type": "string",
          "maxLength": 15000,
          "description": "Full song lyrics."
        },
        "characterIds": {
          "type": "array",
          "description": "Connected character document IDs (max 30 items)."
        },
        "workId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional referenced work ID."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "title",
        "artist",
        "coverImage",
        "audioUrl",
        "lyrics",
        "characterIds",
        "workId",
        "order",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Link": {
      "title": "Link",
      "description": "Archive configuration entries (notice bar, archive info line, header external shortcuts) and custom links.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["notice", "archive", "header", "custom"],
          "description": "Link or site slot category."
        },
        "label": {
          "type": "string",
          "maxLength": 300,
          "description": "Display text or notice message."
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "description": "Target external URL."
        },
        "image": {
          "type": "object",
          "description": "Optional image object {url, source} (e.g., notice bar logo)."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who created or updated the document."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["kind", "label", "url", "image", "order", "ownerId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/works/{workId}": {
      "schema": { "$ref": "#/entities/Work" },
      "description": "Publicly readable works catalog; single-admin writes."
    },
    "/characters/{characterId}": {
      "schema": { "$ref": "#/entities/Character" },
      "description": "Publicly readable character profiles linked to works; single-admin writes."
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/Video" },
      "description": "Publicly readable YouTube video entries; single-admin writes."
    },
    "/songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "Publicly readable CD album music tracks; single-admin writes."
    },
    "/links/{linkId}": {
      "schema": { "$ref": "#/entities/Link" },
      "description": "Publicly readable notice bar, archive info, header shortcuts, and links; single-admin writes."
    }
  }
}
